# Webhook notifications — copy this to .env and fill in your values.
# .env is gitignored and never committed.  Settings can also be
# configured from the dashboard GUI (persisted to disk).

# Toggle to enable/disable all webhook notifications (true | false)
# NOTIFY_ENABLED=true

# Required to enable notifications
# NOTIFY_WEBHOOK_URL=https://api.pushover.net/1/messages.json

# Payload format: generic | pushover | teams | slack | discord
# NOTIFY_FORMAT=pushover

# Events to notify on: started, finished, idle, working, attention
# NOTIFY_ON=idle,attention

# Pushover-specific (only needed for NOTIFY_FORMAT=pushover)
# NOTIFY_PUSHOVER_TOKEN=
# NOTIFY_PUSHOVER_USER=

# Extra HTTP headers as JSON (optional)
# NOTIFY_HEADERS={"Authorization":"Bearer xxx"}

# Git ref for hook script downloads.  Defaults to "main".  Set to a
# branch name or tag (e.g. "feat/my-feature") during development so
# the hooks panel pulls the script from the correct source.
# GIT_REF=main

# ---------------------------------------------------------------------------
# Hook script download tuning
# ---------------------------------------------------------------------------

# Override the GitHub repo used for hook script downloads.
# HOOKS_REPO=danielcg-net/claude_status_dashboard

# Override the git ref / version used to download the hook script.
# Defaults to the build-time git ref or the running server's git branch.
# HOOKS_VERSION=main

# How often (ms) the server checks whether hooks are still installed.
# Default 300000 (5 min).
# HOOKS_HEALTH_CHECK_INTERVAL_MS=300000

# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

# Sessions in 'working' or 'attention' state without updates for this long
# (ms) are auto-transitioned to 'idle'.  Default 300000 (5 min).
# SESSION_STALE_IDLE_MS=300000

# Hard eviction: sessions older than this (ms) are removed entirely.
# Default 604800000 (7 days).
# SESSION_TTL_MS=604800000

# How often (ms) the TTL eviction check runs.  Default 3600000 (1 hour).
# SESSION_EVICT_INTERVAL_MS=3600000
