{
  "name": "claude-status-dashboard",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/build-client.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "ccusage": "^20.0.14",
    "hono": "^4.8.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
