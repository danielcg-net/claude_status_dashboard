{
  "name": "claude-status-dashboard",
  "version": "0.11.1",
  "description": "Real-time web dashboard for monitoring Claude Code sessions — costs, statuses, and history at a glance.",
  "keywords": [
    "claude-code",
    "anthropic",
    "dashboard",
    "monitoring",
    "hooks",
    "ccusage"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielcg-net/claude_status_dashboard.git"
  },
  "bugs": {
    "url": "https://github.com/danielcg-net/claude_status_dashboard/issues"
  },
  "homepage": "https://github.com/danielcg-net/claude_status_dashboard#readme",
  "author": {
    "name": "danielcg-net"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/server.js",
  "exports": {
    ".": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "claude-status-dashboard": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "public/",
    "hooks/",
    "Dockerfile",
    "WEBHOOK.md",
    "compose.yml",
    "install.sh"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/write-git-ref.mjs && node scripts/build-client.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "prepack": "GIT_REF=v$(node -p \"require('./package.json').version\") npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "ccusage": "^20.0.14",
    "hono": "^4.8.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.25.5",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.9"
  }
}
